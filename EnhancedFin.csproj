<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net10.0 imposé par Jellyfin.Controller 12 (10.11 était en net9.0). -->
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Jellyfin.Plugin.EnhancedFin</AssemblyName>
    <RootNamespace>Jellyfin.Plugin.EnhancedFin</RootNamespace>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- On démarre propre, autant le rester : un warning ignoré aujourd'hui
         est une dette demain. À repasser à false si ça devient bloquant. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Build reproductible : les chemins de source gravés dans le DLL et le PDB (piles
         d'appels, Source Link) deviennent `/_/…`. Sans ça, le binaire publié porte le
         chemin de la machine qui l'a compilé. -->
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <!-- 12.0.0 et pas 12.1.0 : compatible avec toutes les 12.x. Jellyfin 12 est
         passé à .NET 10 et a cassé la compat binaire des plugins : un même binaire
         ne sert pas 10.11 et 12. -->
    <PackageReference Include="Jellyfin.Controller" Version="12.0.0" />
    <PackageReference Include="Jellyfin.Model" Version="12.0.0" />
    <!-- Exactement la version embarquée par Jellyfin (12.1 : 10.0.11). C'est la sienne
         qui est chargée : une version plus haute ici et le plugin ne démarre pas
         (FileNotFoundException sur Microsoft.Data.Sqlite). Vérifier à chaque Jellyfin. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
  </ItemGroup>

</Project>
